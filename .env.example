# ==============================================================================
# انسخ هذا الملف لـ .env وعبّيه. ملف .env نفسه لا يُرفع على جيت أبدا.
#   cp .env.example .env
# ==============================================================================

# --- قاعدة البيانات ------------------------------------------------------------
# محليا: بيطابق docker-compose.yml بالضبط، ما بدك تغيّر إشي
# ⚠️ المستخدم لازم يكون sufria_dashboard أو sufria_engine — مش postgres.
#    دور superuser بيلغي كل سياسات RLS بصمت. التطبيق بيرفض يقلع لو صار.
DATABASE_URL=postgres://sufria_dashboard:devpass@localhost:5432/sufria
ENGINE_DATABASE_URL=postgres://sufria_engine:devpass@localhost:5432/sufria

# للـmigrations فقط (بيحتاج صلاحيات إنشاء). مش للتطبيق.
MIGRATION_DATABASE_URL=postgres://postgres:devpass@localhost:5432/sufria

PG_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# ولّد واحد جديد لكل بيئة:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_local_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- WhatsApp Cloud API -------------------------------------------------------
# من developers.facebook.com بعد إضافة منتج WhatsApp للتطبيق
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# نص بتخترعه إنت، وبتحطه بنفس الوقت بإعدادات الـwebhook عند ميتا
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# من إعدادات التطبيق عند ميتا — بيستخدم للتحقق من توقيع الـwebhook
WHATSAPP_APP_SECRET=

# مُراقِب إشعارات الزبون (FR-11): دورة كل كم ملّي ثانية، و0 بيطفيه.
NOTIFY_POLL_MS=5000

# جلسة محادثة سكتت هالعدد من الدقائق بتنتهي، وأول رسالة بعدها بتبلّش من الترحيب والمنيو.
SESSION_IDLE_MINUTES=60

# رسالة الزبون بعد طلبه بتروح للمطعم (بريف م-أ): طلب ماشي أصغر من هيك · طلب خلص من أقل من هيك · وسكوت السطر بين ردّين، بالدقائق.
RELAY_OPEN_ORDER_MAX_MINUTES=180
RELAY_CLOSED_ORDER_MINUTES=60
RELAY_REPLY_QUIET_MINUTES=10

# الموظف بيكتب للزبون (بريف م-ج): سكوت البوت ونافذة الرد بالدقائق (الـAPI) · دورة الطابور بالملّي ثانية و0 بيطفيه، وأقصى انتظار للرسالة بالثواني (المحرّك).
BOT_SILENCE_MINUTES=60
REPLY_WINDOW_MINUTES=1430
STAFF_REPLY_POLL_MS=1000
STAFF_REPLY_MAX_WAIT_SECONDS=120

# وسائط الزبون (بريف م-هـ-أ): دورة طابور التنزيل من ميتا بالملّي ثانية، و0 بيطفيه (المحرّك).
MEDIA_POLL_MS=2000

# --- سكربت العرض scripts/demo-order-status.mjs (تطوير فقط، لا مطعم حقيقي) ---
# حساب موظف بمطعم واحد. السكربت ما بيطبعهم.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# --- بوابة الدفع (Sprint 2، فاضية لحد وقتها) -----------------------------------
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- عام ----------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
ENGINE_PORT=3001
DASHBOARD_API_PORT=3002
DASHBOARD_WEB_PORT=3000

# --- لوحة المطعم (dashboard-web) ---------------------------------------------
# أصل الواجهة اللي بيسمحله الـAPI (CORS). أكتر من أصل: افصلهم بفاصلة.
DASHBOARD_WEB_ORIGIN=http://localhost:3000
# عنوان الـAPI اللي بتكلّمه الواجهة من المتصفح. بيندمج بالواجهة وقت التشغيل —
# تغييره بدّه إعادة تشغيل `next dev`.
NEXT_PUBLIC_API_URL=http://localhost:3002
